# Telegram
BOT_TOKEN=your_telegram_bot_token

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_key
# One of: deepseek-chat | gemini | mistral | claude | gpt
OPENROUTER_MODEL=deepseek-chat
# Optional separate model for vision/image checks (OpenRouter model id)
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Optional: custom system prompt for /ai (otherwise built-in default is used)
# AI_SYSTEM_PROMPT=You are a helpful assistant.

# Comma-separated Telegram user IDs of administrators
ADMIN_IDS=123456789,987654321

# Optional paths
DATABASE_PATH=bot.db
RULES_JSON_PATH=rules.json
ADMIN_LOG_PATH=logs/admin_actions.log

# HTTP ping server (optional, for watchdog)
PING_HOST=0.0.0.0
PING_PORT=8080

# Rate limits (per user, rolling window)
RATE_LIMIT_WINDOW_SEC=30
RATE_LIMIT_MAX_MESSAGES=25

# Flask web panel (optional)
WEB_PANEL_SECRET=
FLASK_PORT=5000

# Watchdog (optional): chat id for online/offline notifications
WATCHDOG_CHAT_ID=
